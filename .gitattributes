# Mail stores and captured oracle output are binary — never diffed, never
# line-ending-mangled. A PST that git "helpfully" normalises is a corrupt PST.
*.pst binary
*.ost binary
*.bin binary

# Authored EML fixture sources keep their CRLF line endings: the PST generated
# from them (scripts/make_fixture.py) must regenerate byte-for-byte.
*.eml -text
